# CareHarmony HIMS Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR SERVICE ROLE KEYS TO SOURCE CONTROL

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_APP_ENV=development

# Provider credentials (OpenAI, Anthropic, Twilio, Lovable, generic API keys, ...)
# must NEVER be set as VITE_* variables: Vite inlines every VITE_* value into the
# public JavaScript bundle. They belong in Supabase edge-function secrets
# (`supabase secrets set NAME=value`) and are read server-side via Deno.env.get.
# CI enforces this with `npm run security:client-secrets` (SECF-03).

# ---------------------------------------------------------------------------
# Former microservice / Kong compose stack (removed from the tree; see git history) - S0-11.
# The compose files hold NO literal credentials; every value below is required
# (${VAR:?...}) and must be a fresh random value in your untracked .env.
# Generate with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
# ---------------------------------------------------------------------------
# KONG_DB_PASSWORD=
# DB_PASSWORD=
# JWT_SECRET=
# ENCRYPTION_KEY=
# GRAFANA_PASSWORD=
# KONG_ADMIN_GUI_SESSION_SECRET=
# Kong consumer keys + Loggly token, rendered into kong.rendered.yml by the
# former Kong render script (removed from the tree):
# KONG_FRONTEND_API_KEY=
# KONG_MOBILE_API_KEY=
# KONG_ADMIN_API_KEY=
# LOGGLY_TOKEN=

# ---------------------------------------------------------------------------
# Test tooling (never production). scripts/create-test-users.js,
# scripts/seed-*.mjs and tests/e2e/global-setup-seed.ts refuse to run when the
# target is the production project (supabase/config.toml project_id).
# ---------------------------------------------------------------------------
# E2E_TEST_PASSWORD=           # per-run password for seeded test accounts (test project only)
# PRODUCTION_SUPABASE_REFS=    # extra production refs to block (comma-separated)
