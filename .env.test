# !! PLACEHOLDERS / MOCKS ONLY !! Never store production or live staging
# credentials in this file - it is committed to Git. Real secrets belong in your
# shell, CI secrets, or .env.test.local (untracked).
# E2E Test Environment (loaded by `vite --mode test` and vitest).
#
# SECURITY (S0-11 / SECF-21): this file holds NO real credentials.
# - VITE_E2E_MOCK_PASSWORD is the DEV-only mock-auth password. It is honoured
#   only by a DEV build with VITE_E2E_MOCK_AUTH=true (src/contexts/AuthContext.tsx)
#   and is NOT the password of any Supabase account. Never reuse it for one.
# - Real test accounts exist only in the isolated test/staging Supabase project.
#   Their password is supplied per run via E2E_TEST_PASSWORD (or per role via
#   E2E_<ROLE>_PASSWORD) from CI secrets or your shell, never committed here.
#   Put local overrides in .env.test.local (not tracked).

VITE_E2E_MOCK_AUTH=true
# Password the mock-auth flow checks against (DEV/test only). Sourced by AuthContext
# and by tests/e2e/support/test-credentials.ts.
VITE_E2E_MOCK_PASSWORD=MockAuthOnly-NotARealAccount-0
E2E_BASE_URL=http://localhost:8080

E2E_ADMIN_EMAIL=admin@testgeneral.com
E2E_DOCTOR_EMAIL=doctor@testgeneral.com
E2E_NURSE_EMAIL=nurse@testgeneral.com
E2E_RECEPTIONIST_EMAIL=reception@testgeneral.com
E2E_PHARMACIST_EMAIL=pharmacy@testgeneral.com
E2E_LAB_TECHNICIAN_EMAIL=lab@testgeneral.com
E2E_PATIENT_EMAIL=patient@testgeneral.com
