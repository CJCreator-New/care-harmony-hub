{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:boundaries": "depcruise src/modules src/components/doctor src/components/nurse --config .dependency-cruiser.cjs",
    "preview": "vite preview",
    "test": "vitest",
    "validate:rls": "tsx scripts/validate-rls.ts",
    "test:security": "vitest run tests/security",
    "security:client-secrets": "node scripts/security/check-client-secrets.mjs",
    "security:bundle-secrets": "node scripts/security/check-client-secrets.mjs --bundle",
    "test:accessibility": "vitest run src/test/components/layout src/test/components/ui/accessibility-primitives.test.tsx",
    "test:integration": "vitest run --config vitest.integration.config.ts tests/integration",
    "test:api": "vitest run tests/api",
    "test:load": "k6 run tests/performance/load-test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --headed --slow-mo=300",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:staging:clinical": "playwright test --config=playwright.staging.config.ts",
    "test:e2e:roles:auth": "playwright test --config=playwright.roles.config.ts --project=setup-roles",
    "test:e2e:roles:rbac": "playwright test --config=playwright.roles.config.ts",
    "test:e2e:roles": "npm run test:e2e:roles:auth && npm run test:e2e:roles:rbac",
    "test:create-users": "node scripts/create-test-users.js",
    "seed:test-data": "node scripts/seed-test-data.mjs",
    "test:unit": "vitest run src/test",
    "test:unit:all": "vitest run",
    "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "validate:all": "npm run lint && npm run lint:boundaries && npm run test && npm run validate:rls",
    "test:e2e:roles:setup": "playwright test tests/e2e/role-setup-coverage.spec.ts --headed",
    "test:e2e:full": "playwright test --config=playwright.e2e-full.config.ts",
    "test:e2e:seed": "node scripts/seed-e2e-data.mjs",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "db:replay": "node scripts/db/replay-migrations.mjs",
    "db:capture-live": "bash scripts/db/capture-live-schema.sh",
    "prepare": "husky"
  },
  "overrides": {
    "serialize-javascript": "^7.0.4",
    "tar": "^7.5.10",
